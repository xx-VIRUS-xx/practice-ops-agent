# Copy to .env and fill in real values before running.

APP_NAME=practice-ops-agent
ENVIRONMENT=development

# Relational DB. For local dev without docker-compose, sqlite is fine:
# DATABASE_URL=sqlite:///./practice_ops.db
DATABASE_URL=postgresql://practice_ops:practice_ops_dev_password@localhost:5432/practice_ops

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DOMAIN_COLLECTION=domain_knowledge
QDRANT_PATIENT_COLLECTION=patient_memory

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_ME_WITH_A_GENERATED_FERNET_KEY_BASE64==

# Used only to authorize creation of new practices/tenants (POST /practices).
ADMIN_BOOTSTRAP_KEY=dev-admin-bootstrap-key-change-me
